{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLICKED",
  "version": "0.1.0",
  "identifier": "com.flicked.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FLICKED",
        "width": 1240,
        "height": 760,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0c0c0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https://*.steamstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
